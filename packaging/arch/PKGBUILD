# Maintainer: Roy-Åke Martinsson

pkgname=videoshot
pkgver=0.1.0
pkgrel=1
pkgdesc="Screenshots and short video clips of your screen, a window or a selection"
arch=('x86_64')
url="https://github.com/royakem/videoshot"
license=('GPL-2.0-or-later')
depends=('gtk3' 'libhandy' 'libx11' 'libxext' 'ffmpeg')
makedepends=('meson' 'gettext')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
